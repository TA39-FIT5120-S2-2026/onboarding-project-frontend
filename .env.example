VITE_API_BASE_URL=https://onboarding-project-backend.onrender.com

# Use bundled fixtures for route planning instead of calling the backend.
# Refuges and Forecast always use bundled sample data regardless of this
# flag - no backend endpoint exists for either (see docs/BACKEND_GAPS.md).
# Delete this flag before a real deployment - fixtures are for development only.
VITE_USE_FIXTURES=false
